#!/bin/bash
# Lets a project's GitHub workflow deploy to its own namespace: makes the project's deploy key and
# pins it to that namespace. Run once per project, on the VPS:
#
#   sudo /opt/cluster/k8s-add-project <namespace>
#
# It prints the private half once, for the repository's DEPLOY_KEY secret, and keeps no copy of it.
set -euo pipefail

die() { echo "k8s-add-project: $1" >&2; exit 2; }

NAME_RE='^[a-z0-9]([a-z0-9-]{0,28}[a-z0-9])?$'
KEYS=/home/deploy/.ssh/authorized_keys

[[ $EUID -eq 0 ]] || die "run it with sudo"
[[ $# -eq 1 && "$1" =~ $NAME_RE ]] || die "usage: sudo k8s-add-project <namespace>"
ns=$1
[[ -d "$(dirname "$KEYS")" ]] || die "the deploy user is not set up yet (see README.md)"
if grep -qsF "k8s-deploy $ns\"" "$KEYS"; then
  die "$ns already has a key. To replace it, delete its line from $KEYS and run this again"
fi

dir=$(mktemp -d)
trap 'shred -u "$dir"/key 2>/dev/null; rm -rf "$dir"' EXIT
ssh-keygen -q -t ed25519 -N "" -C "$ns-deploy" -f "$dir/key"

printf 'restrict,command="sudo /usr/local/sbin/k8s-deploy %s" %s\n' "$ns" "$(cat "$dir/key.pub")" >> "$KEYS"
chmod 644 "$KEYS"

echo "Added a deploy key for the namespace $ns."
echo "Copy EVERYTHING between the two rows of = signs, the BEGIN and END lines included, into the"
echo "repository's secret DEPLOY_KEY (Settings, Secrets and variables, Actions, Secrets tab):"
echo "======================================================================"
cat "$dir/key"
echo "======================================================================"
echo "It is not stored anywhere on this machine. If it is lost, delete the line from $KEYS and run this again."
