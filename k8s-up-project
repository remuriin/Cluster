#!/bin/bash
# The VPS half of launching a project: its namespace, settings, pods, nginx site and certificate.
# k8s-launch (on the PC) runs it over SSH; it is not meant to be typed by hand.
#
#   sudo bash /opt/cluster/k8s-up-project check <project> <owner/repo> <site>
#   sudo bash /opt/cluster/k8s-up-project apply <project> <owner/repo> <site> <web address> <api address or -> <keep|replace> [setting=value ...]
#
# "check" only looks. It prints what it found, one name=value per line:
#   state=new|own    key=yes|no    web=<address>    api=<address>    secret=yes|no    api-pod=yes|no
# and stops with an error if the project's name or its site already belongs to something else.
#
# "apply" makes it so. Every step is skipped when it is already true, so running it twice changes
# nothing: an existing pod is never applied again (that would put its image back to ":main"), and
# existing settings are only replaced when asked ("replace") and when new ones were handed in.
# The backend's settings arrive on standard input, as NAME=value lines; they go straight into the
# project's secret and are never printed, never put on a command line, never written to a file.
#
# Nothing from the PC is ever applied as it is. This script is handed values only, checks each one,
# and fills in the template that lives here, in /opt/cluster/k8s-template.
#
# Exit codes: 0 done, 2 refused (bad value, or it belongs to something else), 1 a step failed,
# 3 everything is in place except the certificate.
set -euo pipefail

die() { echo "k8s-up-project: $1" >&2; exit "${2:-2}"; }
say() { echo "k8s-up-project: $1"; }

NAME_RE='^[a-z0-9]([a-z0-9-]{0,28}[a-z0-9])?$'
RESERVED_RE='^(default|kube-system|kube-public|kube-node-lease)$'
REPO_RE='^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$'
SITE_RE='^([a-z0-9-]+\.)+[a-z]{2,}$'
IP_RE='^10\.43\.0\.(8[0-9]|9[0-9]|1[0-9][0-9]|2[0-4][0-9])$'
# marks a namespace as made for one repository, so no other project can take it over
OWNER=remservers.me/repo

# K8S_TEST_ROOT is for the tests only: it moves the files this touches into a throwaway folder
# and takes the tools from PATH, where the tests put pretend ones.
T=${K8S_TEST_ROOT:-}
if [[ -n "$T" ]]; then
  KUBECTL=kubectl NGINX=nginx SYSTEMCTL=systemctl CERTBOT=certbot
else
  [[ $EUID -eq 0 ]] || die "run it with sudo"
  KUBECTL=/usr/local/bin/kubectl NGINX=/usr/sbin/nginx SYSTEMCTL=/usr/bin/systemctl CERTBOT=$(command -v certbot || true)
fi
SITES=$T/etc/nginx/sites-available
ENABLED=$T/etc/nginx/sites-enabled
KEYS=$T/home/deploy/.ssh/authorized_keys
here=$(cd "$(dirname "$0")" && pwd)

mode=${1:-}
[[ "$mode" == check || "$mode" == apply ]] || die "usage: k8s-up-project check|apply <project> <owner/repo> <site> ..."
[[ $# -ge 4 ]] || die "usage: k8s-up-project $mode <project> <owner/repo> <site> ..."
project=$2 repo=$3 site=$4
[[ "$project" =~ $NAME_RE ]] || die "bad project name"
[[ ! "$project" =~ $RESERVED_RE ]] || die "$project is one of the cluster's own namespaces"
[[ "$repo" =~ $REPO_RE ]] || die "bad repository name"
[[ "$site" =~ $SITE_RE ]] || die "bad site name"

k() { "$KUBECTL" "$@"; }
exists() { k -n "$project" get "$1" "$2" >/dev/null 2>&1; }

# --- who does this name belong to ---
state=new
if k get namespace "$project" >/dev/null 2>&1; then
  owner=$(k get namespace "$project" -o "jsonpath={.metadata.annotations.remservers\.me/repo}")
  [[ "$owner" == "$repo" ]] || die "the namespace $project exists and was not made for $repo"
  state=own
fi
# an nginx site with this name that no launched project owns (a site set up by hand)
[[ "$state" == own || ! -e "$SITES/$project" ]] || die "an nginx site called $project exists and belongs to something else"
# the site name, claimed by another site's file
for f in "$SITES"/*; do
  [[ -f "$f" && "$f" != "$SITES/$project" ]] || continue
  ! grep -Eq "(^|[[:space:];{])server_name[[:space:]]([^;]*[[:space:]])?${site//./\\.}[[:space:];]" "$f" || die "the site name $site is already used by $(basename "$f")"
done

if [[ "$mode" == check ]]; then
  [[ $# -eq 4 ]] || die "check takes a project, a repository and a site"
  taken=$(k get services -A -o 'jsonpath={range .items[*]}{.spec.clusterIP}{"\n"}{end}')
  have() { k -n "$project" get service "$1" -o 'jsonpath={.spec.clusterIP}' 2>/dev/null || true; }
  # the lowest free addresses of the hand-picked range, skipping what is taken and what was just picked
  free() {
    local n
    for n in $(seq 80 249); do
      grep -qxF "10.43.0.$n" <<<"$taken"$'\n'"${1:-}" || { echo "10.43.0.$n"; return; }
    done
  }
  web=$(have web); [[ -n "$web" ]] || web=$(free)
  api=$(have api); [[ -n "$api" ]] || api=$(free "$web")
  [[ -n "$web" && -n "$api" ]] || die "no free address left between 10.43.0.80 and 10.43.0.249" 1
  echo "state=$state"
  if grep -qsF "k8s-deploy $project\"" "$KEYS"; then echo "key=yes"; else echo "key=no"; fi
  echo "web=$web"
  echo "api=$api"
  if exists secret backend-env; then echo "secret=yes"; else echo "secret=no"; fi
  if exists deployment api; then echo "api-pod=yes"; else echo "api-pod=no"; fi
  exit 0
fi

# --- apply ---
[[ $# -ge 7 ]] || die "apply takes a project, a repository, a site, two addresses and keep|replace"
web=$5 api=$6 settings=$7
shift 7
[[ "$web" =~ $IP_RE ]] || die "bad web address"
[[ "$api" == - || "$api" =~ $IP_RE ]] || die "bad api address"
[[ "$settings" == keep || "$settings" == replace ]] || die "the settings mode is keep or replace"
[[ "$api" != - ]] || api=

# the settings, read once; nothing after this may read standard input
env=$(cat)
exec </dev/null

# the cluster files, filled in here from this machine's own template (it checks the settings too)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
bash "$here/k8s-new-project" --render "$tmp" "$project" "$site" "$web" "${api:--}" "$@" >/dev/null

if [[ "$state" == new ]]; then
  k apply -f "$tmp/k8s/namespace.yaml" >/dev/null
  k annotate namespace "$project" "$OWNER=$repo" >/dev/null
  say "namespace $project created"
fi

if [[ -n "$api" ]]; then
  if [[ -n "$env" ]] && { [[ "$settings" == replace ]] || ! exists secret backend-env; }; then
    # kubectl repeats a line it cannot read in its error, so that error is thrown away
    printf '%s\n' "$env" | k -n "$project" create secret generic backend-env --from-env-file=/dev/stdin --dry-run=client -o yaml 2>/dev/null \
      | k -n "$project" apply -f - >/dev/null 2>&1 \
      || die "the settings could not be stored: every line must be NAME=value" 1
    say "the backend's settings stored"
    # a pod reads its settings once, when it starts
    if exists deployment api; then k -n "$project" rollout restart deployment/api >/dev/null; say "backend restarted to read them"; fi
  elif ! exists secret backend-env; then
    k -n "$project" create secret generic backend-env >/dev/null
    say "an empty set of backend settings created"
  fi
fi
unset env

# a pod that exists is left alone: applying its file again would put its image back to ":main"
for piece in web ${api:+api}; do
  if exists deployment "$piece"; then
    say "pod $piece is already there"
  else
    k apply -f "$tmp/k8s/$piece.yaml" >/dev/null
    say "pod $piece created (it waits for its first image)"
  fi
done

# the nginx site: written when missing, or when a backend arrived and the site has no /api yet
target=$SITES/$project
if [[ ! -e "$target" ]] || { [[ -n "$api" ]] && ! grep -q 'location /api' "$target"; }; then
  backup=
  if [[ -e "$target" ]]; then backup=$tmp/site.before; cp -p "$target" "$backup"; fi
  cp "$tmp/nginx-site.conf" "$target"
  chmod 644 "$target"
  ln -sfn "$target" "$ENABLED/$project"
  if ! "$NGINX" -t >/dev/null 2>&1; then
    # never leave a site behind that breaks every later reload and every certificate renewal
    if [[ -n "$backup" ]]; then cp -p "$backup" "$target"; else rm -f "$target" "$ENABLED/$project"; fi
    die "nginx refused the site file; it was put back as it was" 1
  fi
  "$SYSTEMCTL" reload nginx
  say "nginx site $site written"
fi

# the certificate. certbot edits the site file: it adds the HTTPS half and the redirect to it.
# "--reinstall" makes one command right for both cases: no certificate yet (it gets one), or one
# that exists while the site file was just written again (it is put back in, none is requested).
if ! grep -q 'ssl_certificate' "$target"; then
  [[ -n "$CERTBOT" ]] || die "certbot is not installed" 3
  if ! "$CERTBOT" --nginx -n -d "$site" --reinstall --redirect >/dev/null 2>&1; then
    die "everything is in place except the certificate for $site. Check that the name points at this VPS, then run the launch again" 3
  fi
  say "certificate for $site in place"
fi
say "done"
