# One site for every project launched through Fleet: <name>.remservers.me goes to namespace app-<name>.
# Install as /etc/nginx/sites-available/projects and link it into sites-enabled.
#
# Never edited when a project is added or removed. nginx asks the cluster's own name lookup
# (10.43.0.10) for web.app-<name> (and api.app-<name> for /api) on each request, the same way as
# the rag-<id> rule of Rem RaaS. Only namespaces starting with app- can be reached this way, so
# rem-raas, kube-system or a hand-made namespace never become public by accident.
#
# Names that have their own site (rag, portal, panel, status, monitor, ...) are exact server_names,
# and nginx always prefers an exact name over this pattern, so they never land here. A name with two
# levels (a.b.remservers.me) or the bare IP still lands in 000-catch-all.
#
# The certificate is one wildcard for *.remservers.me, from certbot's Cloudflare DNS plugin
# (certonly, no installer): certbot never edits this file, and renewal reloads nginx by itself.

limit_req_zone $binary_remote_addr zone=projects:10m rate=10r/s;

server {
    listen 80;
    listen 443 ssl;
    server_name "~^(?<project>[a-z0-9]([a-z0-9-]{0,28}[a-z0-9])?)\.remservers\.me$";

    ssl_certificate     /etc/letsencrypt/live/wildcard.remservers.me/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wildcard.remservers.me/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    if ($scheme = http) {
        return 301 https://$host$request_uri;
    }

    # a name is looked up again after 10 seconds, so a removed project stops resolving quickly
    resolver 10.43.0.10 valid=10s ipv6=off;
    resolver_timeout 5s;

    # no project by that name (or it is down): no answer at all, like the catch-all
    error_page 502 504 = @none;
    location @none {
        return 444;
    }

    client_max_body_size 10m;

    location /api {
        limit_req zone=projects burst=20 nodelay;
        include /etc/nginx/snippets/rag-headers.conf;
        proxy_pass http://api.app-$project.svc.cluster.local;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        limit_req zone=projects burst=20 nodelay;
        include /etc/nginx/snippets/rag-headers.conf;
        proxy_pass http://web.app-$project.svc.cluster.local;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
