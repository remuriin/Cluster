# portal.remservers.me (repo RemServers). Installed as /etc/nginx/sites-available/rem-servers.
# Reached through the Cloudflare tunnel (cloudflared -> https://localhost:443 -> this site).
#
# The web app and its backend run in the cluster (namespace rem-servers, run by Flux from the Fleet
# repo). nginx finds their Services by name through the cluster's own name lookup (10.43.0.10), per
# request: the names stay the same when a Service is re-created, a fixed address would not.
server {
    server_name portal.remservers.me;

    # Serve the React frontend
    root /var/www/rem-servers/frontend/dist;
    index index.html;

    # in variables, so nginx looks the names up per request through the resolver, not once at start
    resolver 10.43.0.10 valid=10s ipv6=off;
    set $portal_web web.rem-servers.svc.cluster.local;
    set $portal_api api.rem-servers.svc.cluster.local;

    location / {
        proxy_pass http://$portal_web;
    }

    # Proxy /api requests to Node backend
    location /api {
        proxy_pass http://$portal_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/portal.remservers.me/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/portal.remservers.me/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = portal.remservers.me) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name portal.remservers.me;
    return 404; # managed by Certbot


}
