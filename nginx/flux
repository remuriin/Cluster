# flux.remservers.me: where GitHub's webhooks reach Flux's receiver inside the cluster.
# Install as /etc/nginx/sites-available/flux and link it into sites-enabled.
#
# Only /hook/... is passed on, to the Service webhook-receiver in flux-system (found by name, like the
# other cluster routes). Everything else gets no answer. A call that isn't signed with the shared
# secret is refused by Flux itself, and a signed one can only ask Flux to look now.
# An exact name, so the generic "projects" site never sees it. Certificate: the wildcard.

limit_req_zone $binary_remote_addr zone=flux_hooks:1m rate=2r/s;

server {
    listen 80;
    listen 443 ssl;
    server_name flux.remservers.me;

    ssl_certificate     /etc/letsencrypt/live/wildcard.remservers.me/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wildcard.remservers.me/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    if ($scheme = http) {
        return 301 https://$host$request_uri;
    }

    resolver 10.43.0.10 valid=10s ipv6=off;
    resolver_timeout 5s;

    client_max_body_size 1m;

    # in a variable, so nginx looks the name up per request through the resolver above. A plain name
    # would be looked up once at start through the VPS's own DNS, which doesn't know cluster names.
    set $flux_receiver webhook-receiver.flux-system.svc.cluster.local;

    location /hook/ {
        limit_req zone=flux_hooks burst=20 nodelay;
        proxy_pass http://$flux_receiver;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 444;
    }
}
