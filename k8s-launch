#!/bin/bash
# Launches a project into the cluster: everything between "the project exists and builds" and
# "its site is live and a push to main deploys it". Run on the PC (Git Bash), in this folder:
#
#   ./k8s-launch <project folder> [--settings]
#   ./k8s-launch ../MyApp
#
# The project needs a web app in frontend/ and may have a backend in backend/. A piece with its own
# Dockerfile is used as it is; a Vite web app or a Node backend without one gets the template's.
#
# It asks for the SSH key's passphrase once, then for the project's name and its site. In order it:
# checks everything it can without changing anything; makes the git repository and the GitHub
# repository if there is none; writes the cluster files; stores the build values and the deploy key
# on GitHub; has the VPS create the namespace, the settings, the pods, the nginx site and the
# certificate (k8s-up-project); and, the first time only, commits, pushes and waits for the site.
#
# Run it again any time: every step looks before it acts. After the first launch it never commits:
# it does its part (a backend that was added gets its pod) and leaves the commit to you.
# --settings sends the backend's settings file again and restarts the backend to read it.
#
# What must be in place once: README.md, "Before the first launch".
set -euo pipefail

die() { echo; echo "k8s-launch: $1" >&2; exit 1; }
step() { echo; echo "== $1"; }

OWNER=${K8S_GITHUB_OWNER:-remuriin}
VPS=${K8S_VPS:-ubuntu@140.245.60.8}
VPS_IP=${VPS#*@}
KEY=${K8S_SSH_KEY:-$HOME/.ssh/id_rsa}
# where a new repository is pushed to; only the tests point this somewhere else
GIT_BASE=${K8S_GIT_BASE:-https://github.com}

NAME_RE='^[a-z0-9]([a-z0-9-]{0,28}[a-z0-9])?$'
RESERVED_RE='^(default|kube-system|kube-public|kube-node-lease)$'
SITE_RE='^([a-z0-9-]+\.)+[a-z]{2,}$'
REPO_RE='^[A-Za-z0-9._-]+$'
IP_RE='^10\.43\.0\.[0-9]{2,3}$'

# gh is a Windows program: Git Bash would rewrite any argument that starts with a slash
gh_() { MSYS_NO_PATHCONV=1 gh "$@"; }
# never asks for anything: the key is already unlocked for this run, or the login fails
vps() { ssh -o BatchMode=yes "$VPS" "$@"; }
g() { git -C "$repo" "$@"; }

[[ $# -ge 1 ]] || die "usage: k8s-launch <project folder> [--settings]"
repo=$(cd "$1" 2>/dev/null && pwd) || die "$1 is not a folder"
resend=
[[ "${2:-}" != --settings ]] || resend=1
here=$(cd "$(dirname "$0")" && pwd)

# ---------------------------------------------------------------- A. checks, nothing is changed

step "Looking at the project"
for tool in git ssh ssh-agent ssh-add ssh-keygen gh curl; do
  command -v "$tool" >/dev/null || die "$tool is not installed"
done
[[ -d "$repo/frontend" ]] || die "$repo has no frontend/ folder"

# own: it has a Dockerfile. template: a stack the template has one for. none, or unknown.
kind_of() {
  local d=$repo/$1
  [[ -d "$d" ]] || { echo none; return; }
  [[ ! -e "$d/Dockerfile" ]] || { echo own; return; }
  if [[ -e "$d/package.json" && -e "$d/package-lock.json" ]] && grep -q '"build"' "$d/package.json"; then
    [[ "$1" == backend ]] || grep -q '"vite"' "$d/package.json" || { echo unknown; return; }
    echo template; return
  fi
  echo unknown
}
webkind=$(kind_of frontend)
[[ "$webkind" != unknown ]] || die "frontend/ has no Dockerfile, and it is not a Vite app with a package-lock.json and a build script. Add a Dockerfile for it first"
apikind=$(kind_of backend)
if [[ "$apikind" == unknown ]]; then
  [[ ! -e "$repo/backend/package.json" ]] || die "backend/ has no Dockerfile, and it is not a Node project with a package-lock.json and a build script. Add a Dockerfile for it first"
  read -r -p "backend/ does not look like a backend. Launch the web app only? [y/N] " answer
  [[ "$answer" == [yY]* ]] || die "stopped"
  apikind=none
fi
echo "web app: $([[ $webkind == own ]] && echo "the Dockerfile in frontend/" || echo "the template's Dockerfile (Vite)")"
case $apikind in
  own) echo "backend: the Dockerfile in backend/" ;;
  template) echo "backend: the template's Dockerfile (Node, dist/server.js on port 3000)" ;;
  none) echo "backend: none" ;;
esac

# a project that was launched before says who it is
project=$(awk '/^  name:/{print $2; exit}' "$repo/k8s/namespace.yaml" 2>/dev/null || true)
site=$(awk '/server_name/{gsub(";", "", $2); print $2; exit}' "$repo/nginx-site.conf" 2>/dev/null || true)
if [[ -z "$project" ]]; then
  read -r -p "Project name (lowercase letters, digits, dashes): " project
  read -r -p "Site name [$project.remservers.me]: " site
  [[ -n "$site" ]] || site=$project.remservers.me
fi
[[ "$project" =~ $NAME_RE ]] || die "the project name may only have lowercase letters, digits and dashes (30 at most)"
[[ ! "$project" =~ $RESERVED_RE ]] || die "$project is one of the cluster's own names"
[[ "$site" =~ $SITE_RE ]] || die "expected a site name like $project.remservers.me"

step "Git and GitHub"
[[ "$(gh_ api user -q .login 2>/dev/null)" == "$OWNER" ]] || die "gh is not logged in as $OWNER (gh auth login)"
hascommits=
origin=
if [[ -d "$repo/.git" ]]; then
  ! g rev-parse -q --verify HEAD >/dev/null 2>&1 || hascommits=1
  origin=$(g remote get-url origin 2>/dev/null || true)
  [[ -z "$hascommits" || "$(g symbolic-ref --short HEAD 2>/dev/null)" == main ]] || die "the project is not on the branch main"
fi
first=1
if [[ -n "$origin" ]]; then
  name=$(basename "$origin" .git)
  [[ "$name" =~ $REPO_RE ]] || die "cannot read the repository's name from $origin"
  [[ "$(gh_ repo view "$OWNER/$name" --json visibility -q .visibility 2>/dev/null)" == PUBLIC ]] \
    || die "$OWNER/$name is not a public repository. The cluster downloads images without a login, so it has to be"
  g fetch -q origin
  if g rev-parse -q --verify origin/main >/dev/null 2>&1; then
    [[ "$(g rev-list --count HEAD..origin/main)" == 0 ]] || die "GitHub has commits this folder does not. Pull first"
    # the workflow on GitHub is the sign that this project was launched before
    # (asked by listing the folder: Git Bash would rewrite "origin/main:path" into a Windows path)
    [[ -z "$(g ls-tree --name-only origin/main -- .github/workflows/image.yml)" ]] || first=
  fi
  echo "repository: $OWNER/$name"
else
  read -r -p "GitHub repository name [$(basename "$repo")]: " name
  [[ -n "$name" ]] || name=$(basename "$repo")
  [[ "$name" =~ $REPO_RE ]] || die "a repository name may only have letters, digits, dots, dashes and underscores"
  ! gh_ repo view "$OWNER/$name" >/dev/null 2>&1 || die "$OWNER/$name already exists on GitHub. Pick another name, or link this folder to it first"
  echo "repository: $OWNER/$name (new, public)"
fi
slug=$OWNER/$name

# the VPS runs these scripts as root, from GitHub: what runs there must be what is here
[[ -z "$(git -C "$here" status --porcelain)" ]] || die "the Cluster folder has changes that are not committed"
git -C "$here" fetch -q origin
[[ "$(git -C "$here" rev-parse HEAD)" == "$(git -C "$here" rev-parse origin/main)" ]] || die "the Cluster folder is not pushed (or not pulled)"

step "The VPS"
! ssh-keygen -y -P "" -f "$KEY" >/dev/null 2>&1 || die "the SSH key $KEY has no passphrase. Give it one first: ssh-keygen -p -f $KEY"
eval "$(ssh-agent -s)" >/dev/null
trap 'ssh-agent -k >/dev/null 2>&1 || true' EXIT
# held in memory for a quarter of an hour at most, and gone when this script ends
ssh-add -t 900 "$KEY" || die "the key was not unlocked"
vpsrev=$(vps "cd /opt/cluster && sudo git pull -q --ff-only && sudo git rev-parse HEAD" </dev/null) || die "could not reach the VPS, or /opt/cluster could not be updated"
[[ "$vpsrev" == "$(git -C "$here" rev-parse HEAD)" ]] || die "the VPS does not have this version of the Cluster scripts"
found=$(vps "sudo bash /opt/cluster/k8s-up-project check $project $slug $site" </dev/null) || die "the VPS refused (see the line above)"
val() { sed -n "s/^$1=//p" <<<"$found" | head -1; }
state=$(val state) haskey=$(val key) web=$(val web) api=$(val api) hassecret=$(val secret)
# what came back is checked like anything else that comes from outside
[[ "$state" =~ ^(new|own)$ && "$haskey" =~ ^(yes|no)$ && "$hassecret" =~ ^(yes|no)$ && "$web" =~ $IP_RE && "$api" =~ $IP_RE ]] \
  || die "the VPS gave an answer this does not understand"
[[ "$apikind" != none ]] || api=
echo "namespace $project: $([[ $state == new ]] && echo "free" || echo "this project's own"), web $web${api:+, backend $api}"

# the name has to lead to the VPS itself, not to Cloudflare's proxy, or the certificate cannot be issued
reached=$(curl -s -o /dev/null -m 10 -w '%{remote_ip}' "http://$site/" || true)
[[ "$reached" == "$VPS_IP" ]] || die "$site does not lead to the VPS (it leads to ${reached:-nowhere}). Check the DNS record"

# the backend's settings: the production file if there is one
envfile=
if [[ "$apikind" != none ]]; then
  for f in "$repo/backend/.env.production" "$repo/backend/.env"; do
    [[ ! -f "$f" ]] || { envfile=$f; break; }
  done
fi
if [[ -n "$envfile" ]]; then
  # a line is reported by its number only, never by what it holds
  bad=$(grep -nvE '^[[:space:]]*(#.*)?$|^[A-Za-z_][A-Za-z0-9_]*=' "$envfile" | cut -d: -f1 | tr '\n' ' ' || true)
  [[ -z "$bad" ]] || die "${envfile#"$repo"/}: line(s) $bad are not NAME=value"
  quoted=$(grep -E "^[A-Za-z_][A-Za-z0-9_]*=[\"']" "$envfile" | cut -d= -f1 | tr '\n' ' ' || true)
  local_=$(grep -E '^[A-Za-z_][A-Za-z0-9_]*=.*(localhost|127\.0\.0\.1)' "$envfile" | cut -d= -f1 | tr '\n' ' ' || true)
  echo "backend settings: ${envfile#"$repo"/}"
  [[ -z "$quoted" ]] || echo "  note: quoted values are stored with their quotes: $quoted"
  [[ -z "$local_" ]] || echo "  note: inside a pod \"localhost\" is the pod itself, not the VPS: $local_"
fi
# sent when the project has no settings yet, or when asked
send=
[[ -z "$envfile" ]] || { [[ "$hassecret" == no || -n "$resend" ]] && send=1; }

# a web app with a Dockerfile and no cluster file yet brought that Dockerfile itself
ownweb=
[[ "$webkind" != own || -e "$repo/k8s/web.yaml" ]] || ownweb=1
# what a piece's pod needs to know. A project launched before says it in its own cluster file.
knobs=()
knobs_of() { # $1 web|api, $2 its own Dockerfile or not
  local f=$repo/k8s/$1.yaml port health user mem dport dhealth duser dmem
  if [[ $1 == web ]]; then dport=8080 dhealth=/healthz duser= dmem=64; else dport=3000 dhealth=/ duser=1000 dmem=256; fi
  if [[ -e "$f" ]]; then
    port=$(awk '/containerPort:/{print $3; exit}' "$f")
    health=$(awk '/^ +path:/{print $2; exit}' "$f")
    user=$(awk '/runAsUser:/{print $2; exit}' "$f")
    mem=$(awk '/^ +memory:/{v=$2} END{sub("Mi", "", v); print v}' "$f")
  elif [[ $2 == own ]]; then
    echo "The $([[ $1 == web ]] && echo "web app" || echo backend) has its own Dockerfile, so four things about its image:"
    read -r -p "  port it listens on [$dport]: " port
    read -r -p "  address that answers 200 without a login [$dhealth]: " health
    read -r -p "  user number it runs as, never 0 [${duser:-as the image says}]: " user
    read -r -p "  memory ceiling in MB [$dmem]: " mem
    port=${port:-$dport} health=${health:-$dhealth} user=${user:-$duser} mem=${mem:-$dmem}
  else
    return 0
  fi
  knobs+=("$1-port=$port" "$1-health=$health" "$1-user=$user" "$1-mem=$mem")
}
knobs_of web "$webkind"
[[ "$apikind" == none ]] || knobs_of api "$apikind"
for pair in "${knobs[@]}"; do
  # they travel inside an SSH command, so only what a port, a path, a number can hold
  [[ "$pair" =~ ^(web|api)-(port|health|user|mem)=[A-Za-z0-9._/-]*$ ]] || die "not a usable value: $pair"
done

# values the web app's build writes into the JavaScript: public by nature
vitefile=
for f in "$repo/frontend/.env.production" "$repo/frontend/.env"; do
  [[ ! -f "$f" ]] || { vitefile=$f; break; }
done
vite=()
[[ -z "$vitefile" ]] || mapfile -t vite < <(grep -E '^VITE_[A-Z0-9_]+=' "$vitefile" | tr -d '\r' || true)

# ---------------------------------------------------------------- B. on this PC only

step "Before anything is published"
[[ -d "$repo/.git" ]] || git -C "$repo" init -q -b main
[[ -n "$hascommits" ]] || g symbolic-ref HEAD refs/heads/main
touch "$repo/.gitignore"
for line in '.env' '.env.*' '!.env.example' 'node_modules/' 'dist/'; do
  grep -qxF -- "$line" "$repo/.gitignore" || echo "$line" >> "$repo/.gitignore"
done

# A repository that is not on GitHub yet becomes public with everything in it, and that cannot be
# taken back. So what would go up is searched for things that must not.
if [[ -z "$origin" ]]; then
  if [[ -n "$hascommits" ]]; then list=(ls-files -z); else list=(ls-files -z -co --exclude-standard); fi
  SECRET_NAMES='(^|/)\.env($|\.)|\.(pem|key|p12|pfx|jks|ppk)$|(^|/)id_(rsa|ed25519|ecdsa|dsa)|service-?account[^/]*\.json$|adminsdk[^/]*\.json$|(^|/)\.npmrc$'
  names=$(g "${list[@]}" | tr '\0' '\n' | grep -E "$SECRET_NAMES" | grep -vE '(^|/)\.env\.example$' || true)
  [[ -z "$hascommits" ]] || names+=$'\n'$(g log --all --name-only --format= | sort -u | grep -E "$SECRET_NAMES" | grep -vE '(^|/)\.env\.example$' | sed 's/$/  (in the history)/' || true)
  names=$(sed '/^$/d' <<<"$names")
  [[ -z "$names" ]] || die "these look like secrets and would be published:"$'\n'"$names"$'\n'"Remove them (or add them to .gitignore), then run this again"
  keys=$(cd "$repo" && g "${list[@]}" | xargs -0 -r grep -IlE -e '-----BEGIN [A-Z ]*PRIVATE KEY-----' -e '"private_key"[[:space:]]*:' -- 2>/dev/null || true)
  [[ -z "$keys" ]] || die "these files hold a private key and would be published:"$'\n'"$keys"
  if [[ -n "$envfile" ]]; then
    while IFS= read -r line; do
      n=${line%%=*} v=${line#*=}
      v=${v#[\"\']}; v=${v%[\"\']}
      (( ${#v} >= 12 )) || continue
      hit=$(cd "$repo" && g "${list[@]}" | xargs -0 -r grep -IlF -e "$v" -- 2>/dev/null | tr '\n' ' ' || true)
      [[ -z "$hit" ]] || die "the value of $n from the backend's settings is written in a file that would be published: $hit"
    done < <(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$envfile" | tr -d '\r')
  fi
  echo "nothing that looks like a secret would be published"
fi

echo
echo "About to launch:"
echo "  project     $project  ($([[ $state == new ]] && echo "new" || echo "already in the cluster"))"
echo "  site        https://$site"
echo "  repository  https://github.com/$slug  ($([[ -n "$origin" ]] && echo "exists" || echo "will be created, PUBLIC"))"
echo "  pods        web $web${api:+, backend $api}"
[[ ${#vite[@]} -eq 0 ]] || { echo "  build values, public in the built site (from ${vitefile#"$repo"/}):"; printf '    %s\n' "${vite[@]}"; }
[[ -z "$send" ]] || echo "  the backend's settings will be sent from ${envfile#"$repo"/}"
if [[ -n "$first" ]]; then
  if [[ -n "$hascommits" ]]; then echo "  it will commit the cluster files and push"
  else echo "  it will commit $(g ls-files -co --exclude-standard | wc -l | tr -d ' ') files (the whole project) and push"; fi
else
  echo "  it will not commit: this project was launched before"
fi
read -r -p "Go ahead? [y/N] " answer
[[ "$answer" == [yY]* ]] || die "stopped; nothing was changed outside this folder"

# ---------------------------------------------------------------- C. now it acts

if [[ -z "$origin" ]]; then
  step "Creating the repository on GitHub"
  gh_ repo create "$slug" --public >/dev/null
  g remote add origin "$GIT_BASE/$slug.git"
fi

step "Writing the cluster files"
written=$(bash "$here/k8s-new-project" "$repo" "$project" "$site" "$web" "${api:--}" "${knobs[@]}")
echo "$written" | sed 's/^/  /'
wrote() { grep -qE "^(wrote|rewrote) $1\$" <<<"$written"; }

if [[ ${#vite[@]} -gt 0 ]]; then
  args= lines=
  for pair in "${vite[@]}"; do
    n=${pair%%=*}
    printf '%s' "${pair#*=}" | gh_ variable set "$n" -R "$slug" >/dev/null
    args+="ARG $n\n" lines+="            $n=\${{ vars.$n }}\n"
  done
  # only files this run wrote are touched: the template leaves a marked place for exactly this
  ! wrote frontend/Dockerfile || sed -i "s~^# ARG VITE_API_URL\$~${args%\\n}~" "$repo/frontend/Dockerfile"
  if wrote .github/workflows/image.yml; then
    sed -i -e '/^          #   VITE_API_URL=/d' -e "s~^          # build-args: |\$~          build-args: |\n${lines%\\n}~" "$repo/.github/workflows/image.yml"
  fi
  echo "  build values stored on GitHub: $(printf '%s ' "${vite[@]%%=*}")"
  [[ -z "$ownweb" ]] || echo "  note: the web app has its own Dockerfile; it needs an ARG line for each of them"
fi

if [[ "$haskey" == no ]] || ! gh_ secret list -R "$slug" 2>/dev/null | grep -q '^DEPLOY_KEY'; then
  step "The deploy key"
  # made on the VPS, handed to GitHub, never written to this PC's disk and never shown
  key=$(vps "sudo bash /opt/cluster/k8s-add-project $([[ $haskey == no ]] || echo --replace) $project" </dev/null \
        | sed -n '/BEGIN OPENSSH PRIVATE KEY/,/END OPENSSH PRIVATE KEY/p')
  [[ "$key" == *"BEGIN OPENSSH PRIVATE KEY"*"END OPENSSH PRIVATE KEY"* ]] || die "the VPS did not hand back a key"
  printf '%s\n' "$key" | gh_ secret set DEPLOY_KEY -R "$slug" >/dev/null
  unset key
  echo "  stored as the repository's secret DEPLOY_KEY"
fi

step "On the VPS: namespace, settings, pods, nginx site, certificate"
mode=keep
[[ -z "$resend" ]] || mode=replace
code=0
if [[ -n "$send" ]]; then
  vps "sudo bash /opt/cluster/k8s-up-project apply $project $slug $site $web ${api:--} $mode ${knobs[*]}" < "$envfile" || code=$?
else
  vps "sudo bash /opt/cluster/k8s-up-project apply $project $slug $site $web ${api:--} $mode ${knobs[*]}" </dev/null || code=$?
fi
[[ $code -eq 0 ]] || die "the VPS part stopped (see above). Fix the cause and run this again; it continues where it stopped"

if [[ -z "$first" ]]; then
  step "Done on the VPS. The commit is yours"
  changes=$(g status --short)
  if [[ -n "$changes" ]]; then
    echo "$changes" | sed 's/^/  /'
    echo "Look at them (git diff), commit and push. Until the push, a new pod waits for its image"
    [[ -z "$api" ]] || echo "(a backend that was just added answers 502 at /api until then)."
  else
    echo "Nothing changed in the project."
  fi
  exit 0
fi

step "First commit and push"
if [[ -n "$hascommits" ]]; then
  mapfile -t add < <(sed -nE 's/^(wrote|rewrote) //p' <<<"$written")
  g -c core.safecrlf=false add -- .gitignore "${add[@]}"
  g commit -q -m "cluster files: the project is launched"
else
  g -c core.safecrlf=false add -A
  g commit -q -m "first commit, with the cluster files"
fi
g push -q -u origin main
sha=$(g rev-parse HEAD)
echo "  pushed ${sha:0:7}"

step "Waiting for the pipeline"
run=
for _ in $(seq 1 30); do
  run=$(gh_ run list -R "$slug" --commit "$sha" --json databaseId -q '.[0].databaseId' 2>/dev/null || true)
  [[ -z "$run" ]] || break
  sleep 3
done
[[ -n "$run" ]] || die "no pipeline run appeared for this push. Look at https://github.com/$slug/actions"
if ! gh_ run watch "$run" -R "$slug" --exit-status >/dev/null 2>&1; then
  # the one cause this can name by itself: an image the cluster is not allowed to download
  token=$(curl -s -m 10 "https://ghcr.io/token?scope=repository:$OWNER/$project-web:pull" | sed -E 's/.*"token":"([^"]+)".*/\1/' || true)
  public=$(curl -s -o /dev/null -m 10 -w '%{http_code}' -H "Authorization: Bearer $token" \
    -H 'Accept: application/vnd.oci.image.index.v1+json,application/vnd.docker.distribution.manifest.v2+json' \
    "https://ghcr.io/v2/$OWNER/$project-web/manifests/$sha" || true)
  [[ "$public" == 200 ]] || echo "The image is not public. On GitHub: your profile, Packages, $project-web, Package settings, Change visibility."
  die "the pipeline run failed: https://github.com/$slug/actions/runs/$run"$'\n'"Fix the cause, then re-run the failed job there (or: gh run rerun $run --failed -R $slug)"
fi
echo "  the run is green"

code=$(curl -s -o /dev/null -m 20 -w '%{http_code}' "https://$site/" || true)
[[ "$code" == 200 ]] || die "the pipeline is green but https://$site/ answers ${code:-nothing}"
step "Live: https://$site"
echo "From now on a push to main deploys it. Add the project to Kubernetes-and-pipeline.md:"
echo "  | \`$project\` | \`web\` | ... | \`$web\` | \`$site/\` |${api:+  and \`api\` at \`$api\`}"
