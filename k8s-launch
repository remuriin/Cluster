#!/bin/bash
# Launches a project into the cluster: everything between "the project exists and builds" and
# "its site is live and a push to main deploys it". Run on the PC (Git Bash), in this folder:
#
#   ./k8s-launch <project folder> [--settings]
#   ./k8s-launch ../MyApp
#
# The project needs a web app in frontend/ and may have a backend in backend/. A piece with its own
# Dockerfile is used as it is; a Vite web app or a Node backend without one gets the template's.
#
# Nothing here logs in to the VPS. The cluster follows the Fleet repo (Flux), so a launch is: the
# project's repository on GitHub with a workflow that builds its images, a webhook that tells Flux
# about each build, and the project's folder in Fleet. The site is <name>.remservers.me, served by
# the front door through the project's own route (one wildcard certificate, nothing else per project).
#
# It asks for the project's name the first time. In order it: checks everything it can without
# changing anything; makes the GitHub repository if there is none; writes the project's workflow
# (and Dockerfiles where the template has them); stores the build values and the webhook on GitHub;
# and, the first time only, commits and pushes the project, waits for its images, writes and pushes
# its Fleet folder, and waits for the site.
#
# Run it again any time: every step looks before it acts. After the first launch it never commits:
# it does its part (a backend that was added gets its Fleet files) and leaves the commits to you.
# --settings encrypts the backend's settings file again into Fleet (the commit is yours).
#
# What must be in place once: README.md, "Before the first launch".
set -euo pipefail

die() { echo; echo "k8s-launch: $1" >&2; exit 1; }
step() { echo; echo "== $1"; }

OWNER=${K8S_GITHUB_OWNER:-remuriin}
DOMAIN=${K8S_DOMAIN:-remservers.me}
VPS_IP=${K8S_VPS_IP:-140.245.60.8}
HOOK_HOST=${K8S_HOOK_HOST:-https://flux.remservers.me}
HOOK_TOKEN=${K8S_HOOK_TOKEN:-$HOME/.fleet/webhook-token}
# where a new repository is pushed to; only the tests point this somewhere else
GIT_BASE=${K8S_GIT_BASE:-https://github.com}

NAME_RE='^[a-z0-9]([a-z0-9-]{0,28}[a-z0-9])?$'
# names that are a site of their own, a namespace of the cluster, or an image another project uses
RESERVED_RE='^(default|kube-.*|flux|flux-system|flagger|flagger-system|flagger-loadtester|www|api|mail|rag|raas|rag-api|remservers|rem-servers|rem-raas|rem-raas-backend|rem-raas-clients|portal|panel|status|monitor|node|learnhub|learnhub-api|course-sandbox)$'
REPO_RE='^[A-Za-z0-9._-]+$'
TAG_RE='^(main|main-[0-9a-f]{40}-[0-9]+)$'

# gh is a Windows program: Git Bash would rewrite any argument that starts with a slash
gh_() { MSYS_NO_PATHCONV=1 gh "$@"; }
g() { git -C "$repo" "$@"; }
f() { git -C "$fleet" "$@"; }

[[ $# -ge 1 ]] || die "usage: k8s-launch <project folder> [--settings]"
repo=$(cd "$1" 2>/dev/null && pwd) || die "$1 is not a folder"
resend=
[[ "${2:-}" != --settings ]] || resend=1
here=$(cd "$(dirname "$0")" && pwd)
fleet=$(cd "${K8S_FLEET:-$here/../Fleet}" 2>/dev/null && pwd) || die "no Fleet folder at ${K8S_FLEET:-$here/../Fleet} (git clone https://github.com/$OWNER/Fleet.git next to this one)"

# ---------------------------------------------------------------- A. checks, nothing is changed

step "Looking at the project"
for tool in git gh curl sops; do
  command -v "$tool" >/dev/null || die "$tool is not installed"
done
[[ -d "$repo/frontend" ]] || die "$repo has no frontend/ folder"

# own: it has a Dockerfile of its own. template: a stack the template has one for (or the Dockerfile
# is the template's, written by an earlier run). none, or unknown.
kind_of() {
  local d=$repo/$1
  [[ -d "$d" ]] || { echo none; return; }
  if [[ -e "$d/Dockerfile" ]]; then
    if [[ "$(head -1 "$d/Dockerfile" | tr -d '\r')" == "$(head -1 "$here/k8s-template/$1/Dockerfile")" ]]; then echo template; else echo own; fi
    return
  fi
  if [[ -e "$d/package.json" && -e "$d/package-lock.json" ]] && grep -q '"build"' "$d/package.json"; then
    [[ "$1" == backend ]] || grep -q '"vite"' "$d/package.json" || { echo unknown; return; }
    echo template; return
  fi
  echo unknown
}
webkind=$(kind_of frontend)
[[ "$webkind" != unknown ]] || die "frontend/ has no Dockerfile, and it is not a Vite app with a package-lock.json and a build script. Add a Dockerfile for it first"
apikind=$(kind_of backend)
if [[ "$apikind" == unknown ]]; then
  [[ ! -e "$repo/backend/package.json" ]] || die "backend/ has no Dockerfile, and it is not a Node project with a package-lock.json and a build script. Add a Dockerfile for it first"
  read -r -p "backend/ does not look like a backend. Launch the web app only? [y/N] " answer
  [[ "$answer" == [yY]* ]] || die "stopped"
  apikind=none
fi
echo "web app: $([[ $webkind == own ]] && echo "the Dockerfile in frontend/" || echo "the template's Dockerfile (Vite)")"
case $apikind in
  own) echo "backend: the Dockerfile in backend/" ;;
  template) echo "backend: the template's Dockerfile (Node, dist/server.js on port 3000)" ;;
  none) echo "backend: none" ;;
esac

step "Fleet"
[[ -d "$fleet/.git" ]] || die "$fleet is not a git repository"
[[ "$(f symbolic-ref --short HEAD 2>/dev/null)" == main ]] || die "the Fleet folder is not on the branch main"
[[ -z "$(f status --porcelain)" ]] || die "the Fleet folder has changes that are not committed. Commit or undo them first"
# the bot pushes to Fleet too, so it is brought up to date first
f pull -q --rebase || die "could not update the Fleet folder (git pull --rebase)"
recipient=$(grep -oE 'age1[0-9a-z]{58}' "$fleet/.sops.yaml" 2>/dev/null | head -1 || true)
[[ -n "$recipient" ]] || die "Fleet has no .sops.yaml with the age public key (README.md, \"Before the first launch\")"
hookpath=$(tr -d '\r\n' < "$fleet/projects-hook" 2>/dev/null || true)
[[ "$hookpath" =~ ^/hook/[0-9a-f]{64}$ ]] || die "Fleet has no projects-hook file with the webhook's path (README.md, \"Before the first launch\")"
echo "Fleet is up to date and clean"

step "Git and GitHub"
[[ "$(gh_ api user -q .login 2>/dev/null)" == "$OWNER" ]] || die "gh is not logged in as $OWNER (gh auth login)"
hascommits=
origin=
# whether anything of the project is on GitHub yet (a repository made by a run that stopped is empty)
pushed=
if [[ -d "$repo/.git" ]]; then
  ! g rev-parse -q --verify HEAD >/dev/null 2>&1 || hascommits=1
  origin=$(g remote get-url origin 2>/dev/null || true)
  [[ -z "$hascommits" || "$(g symbolic-ref --short HEAD 2>/dev/null)" == main ]] || die "the project is not on the branch main"
fi
if [[ -n "$origin" ]]; then
  name=$(basename "$origin" .git)
  [[ "$name" =~ $REPO_RE ]] || die "cannot read the repository's name from $origin"
  [[ "$(gh_ repo view "$OWNER/$name" --json visibility -q .visibility 2>/dev/null)" == PUBLIC ]] \
    || die "$OWNER/$name is not a public repository. The cluster downloads images without a login, so it has to be"
  g fetch -q origin
  if g rev-parse -q --verify origin/main >/dev/null 2>&1; then
    pushed=1
    [[ "$(g rev-list --count HEAD..origin/main)" == 0 ]] || die "GitHub has commits this folder does not. Pull first"
  fi
  echo "repository: $OWNER/$name"
else
  read -r -p "GitHub repository name [$(basename "$repo")]: " name
  [[ -n "$name" ]] || name=$(basename "$repo")
  [[ "$name" =~ $REPO_RE ]] || die "a repository name may only have letters, digits, dots, dashes and underscores"
  ! gh_ repo view "$OWNER/$name" >/dev/null 2>&1 || die "$OWNER/$name already exists on GitHub. Pick another name, or link this folder to it first"
  echo "repository: $OWNER/$name (new, public)"
fi
slug=$OWNER/$name

# a project launched before has a folder in Fleet whose namespace carries this repository's mark
mark=$(sed 's/[.]/[.]/g' <<<"remservers.me/repo: $slug")
# (a Fleet folder on Windows may hold its files with Windows line endings: a \r at the end is allowed)
nsfile=$(grep -lE "^    $mark"$'\r'"?\$" "$fleet"/apps/*/namespace.yaml 2>/dev/null | head -1 || true)
project=
[[ -z "$nsfile" ]] || project=$(basename "$(dirname "$nsfile")")
first=1
if [[ -n "$project" ]]; then
  first=
  echo "launched before as $project"
else
  read -r -p "Project name, also the site's name (lowercase letters, digits, dashes): " project
  [[ "$project" =~ $NAME_RE ]] || die "the project name may only have lowercase letters, digits and dashes (30 at most)"
  [[ ! "$project" =~ $RESERVED_RE ]] || die "$project is taken by a site or a part of the cluster. Pick another name"
  [[ ! -e "$fleet/apps/$project" ]] || die "$project is already in Fleet, for another repository. Pick another name"
fi
site=$project.$DOMAIN

# the name must lead to the VPS itself (the wildcard record, not behind Cloudflare's proxy)
reached=$(curl -s -o /dev/null -m 10 -w '%{remote_ip}' "http://$site/" || true)
[[ "$reached" == "$VPS_IP" ]] || die "$site does not lead to the VPS (it leads to ${reached:-nowhere}). Check the DNS record *.$DOMAIN"

# the backend's settings: the production file if there is one
envfile=
if [[ "$apikind" != none ]]; then
  for e in "$repo/backend/.env.production" "$repo/backend/.env"; do
    [[ ! -f "$e" ]] || { envfile=$e; break; }
  done
fi
if [[ -n "$envfile" ]]; then
  # a line is reported by its number only, never by what it holds
  bad=$(tr -d '\r' < "$envfile" | grep -nvE '^[[:space:]]*(#.*)?$|^[A-Za-z_][A-Za-z0-9_]*=' | cut -d: -f1 | tr '\n' ' ' || true)
  [[ -z "$bad" ]] || die "${envfile#"$repo"/}: line(s) $bad are not NAME=value"
  quoted=$(grep -E "^[A-Za-z_][A-Za-z0-9_]*=[\"']" "$envfile" | cut -d= -f1 | tr '\n' ' ' || true)
  local_=$(grep -E '^[A-Za-z_][A-Za-z0-9_]*=.*(localhost|127\.0\.0\.1)' "$envfile" | cut -d= -f1 | tr '\n' ' ' || true)
  echo "backend settings: ${envfile#"$repo"/}"
  [[ -z "$quoted" ]] || echo "  note: quoted values are stored with their quotes: $quoted"
  [[ -z "$local_" ]] || echo "  note: inside a pod \"localhost\" is the pod itself, not the VPS: $local_"
fi
a=$fleet/apps/$project
# encrypted into Fleet: at the first launch, when a backend arrives later, or when asked
send=
if [[ -n "$envfile" ]]; then
  [[ -z "$first" && -e "$a/backend.env" && -z "$resend" ]] || send=1
fi
hasenv=
[[ -z "$send" && ! -e "$a/backend.env" ]] || hasenv=1

# what a piece's pod needs to know. A project launched before says it in its own Fleet file.
knobs=()
knobs_of() { # $1 web|api, $2 its own Dockerfile or not
  local file=$a/$1.yaml port health user mem dport dhealth duser dmem
  if [[ $1 == web ]]; then dport=8080 dhealth=/healthz duser= dmem=64; else dport=3000 dhealth=/ duser=1000 dmem=256; fi
  if [[ -e "$file" ]]; then
    port=$(tr -d '\r' < "$file" | awk '/containerPort:/{print $3; exit}')
    health=$(tr -d '\r' < "$file" | awk '/^ +path:/{print $2; exit}')
    user=$(tr -d '\r' < "$file" | awk '/runAsUser:/{print $2; exit}')
    mem=$(tr -d '\r' < "$file" | awk '/^ +memory:/{v=$2} END{sub("Mi", "", v); print v}')
  elif [[ $2 == own ]]; then
    echo "The $([[ $1 == web ]] && echo "web app" || echo backend) has its own Dockerfile, so four things about its image:"
    read -r -p "  port it listens on [$dport]: " port
    read -r -p "  address that answers 200 without a login [$dhealth]: " health
    read -r -p "  user number it runs as, never 0 [${duser:-as the image says}]: " user
    read -r -p "  memory ceiling in MB [$dmem]: " mem
    port=${port:-$dport} health=${health:-$dhealth} user=${user:-$duser} mem=${mem:-$dmem}
  else
    return 0
  fi
  knobs+=("$1-port=$port" "$1-health=$health" "$1-user=$user" "$1-mem=$mem")
}
knobs_of web "$webkind"
[[ "$apikind" == none ]] || knobs_of api "$apikind"

# values the web app's build writes into the JavaScript: public by nature
vitefile=
for e in "$repo/frontend/.env.production" "$repo/frontend/.env"; do
  [[ ! -f "$e" ]] || { vitefile=$e; break; }
done
vite=()
[[ -z "$vitefile" ]] || mapfile -t vite < <(grep -E '^VITE_[A-Z0-9_]+=' "$vitefile" | tr -d '\r' || true)

# the webhook is signed with the token Flux has; only needed if the repository has no webhook yet
hashook=
if [[ -n "$origin" ]] && gh_ api "repos/$slug/hooks" -q '.[].config.url' 2>/dev/null | grep -q "^$HOOK_HOST/hook/"; then hashook=1; fi
[[ -n "$hashook" || -s "$HOOK_TOKEN" ]] || die "the webhook secret $HOOK_TOKEN is missing (README.md, \"Before the first launch\")"

# ---------------------------------------------------------------- B. on this PC only

step "Before anything is published"
[[ -d "$repo/.git" ]] || git -C "$repo" init -q -b main
[[ -n "$hascommits" ]] || g symbolic-ref HEAD refs/heads/main
touch "$repo/.gitignore"
for line in '.env' '.env.*' '!.env.example' 'node_modules/' 'dist/'; do
  grep -qxF -- "$line" "$repo/.gitignore" || echo "$line" >> "$repo/.gitignore"
done

# A repository that is not on GitHub yet becomes public with everything in it, and that cannot be
# taken back. So what would go up is searched for things that must not.
if [[ -z "$pushed" ]]; then
  if [[ -n "$hascommits" ]]; then list=(ls-files -z); else list=(ls-files -z -co --exclude-standard); fi
  SECRET_NAMES='(^|/)\.env($|\.)|\.(pem|key|p12|pfx|jks|ppk)$|(^|/)id_(rsa|ed25519|ecdsa|dsa)|service-?account[^/]*\.json$|adminsdk[^/]*\.json$|(^|/)\.npmrc$'
  names=$(g "${list[@]}" | tr '\0' '\n' | grep -E "$SECRET_NAMES" | grep -vE '(^|/)\.env\.example$' || true)
  [[ -z "$hascommits" ]] || names+=$'\n'$(g log --all --name-only --format= | sort -u | grep -E "$SECRET_NAMES" | grep -vE '(^|/)\.env\.example$' | sed 's/$/  (in the history)/' || true)
  names=$(sed '/^$/d' <<<"$names")
  [[ -z "$names" ]] || die "these look like secrets and would be published:"$'\n'"$names"$'\n'"Remove them (or add them to .gitignore), then run this again"
  keys=$(cd "$repo" && g "${list[@]}" | xargs -0 -r grep -IlE -e '-----BEGIN [A-Z ]*PRIVATE KEY-----' -e '"private_key"[[:space:]]*:' -- 2>/dev/null || true)
  [[ -z "$keys" ]] || die "these files hold a private key and would be published:"$'\n'"$keys"
  if [[ -n "$envfile" ]]; then
    while IFS= read -r line; do
      n=${line%%=*} v=${line#*=}
      v=${v#[\"\']}; v=${v%[\"\']}
      (( ${#v} >= 12 )) || continue
      hit=$(cd "$repo" && g "${list[@]}" | xargs -0 -r grep -IlF -e "$v" -- 2>/dev/null | tr '\n' ' ' || true)
      [[ -z "$hit" ]] || die "the value of $n from the backend's settings is written in a file that would be published: $hit"
    done < <(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$envfile" | tr -d '\r')
  fi
  echo "nothing that looks like a secret would be published"
fi

echo
echo "About to launch:"
echo "  project     $project  ($([[ -n "$first" ]] && echo "new" || echo "launched before"))"
echo "  site        https://$site"
echo "  repository  https://github.com/$slug  ($([[ -n "$origin" ]] && echo "exists" || echo "will be created, PUBLIC"))"
if [[ "$apikind" == none ]]; then echo "  pieces      web app"; else echo "  pieces      web app and backend"; fi
[[ ${#vite[@]} -eq 0 ]] || { echo "  build values, public in the built site (from ${vitefile#"$repo"/}):"; printf '    %s\n' "${vite[@]}"; }
[[ -z "$send" ]] || echo "  the backend's settings will be encrypted into Fleet from ${envfile#"$repo"/}"
if [[ -n "$first" ]]; then
  if [[ -n "$hascommits" ]]; then echo "  it will commit the project's new files and push, then commit its Fleet folder and push"
  else echo "  it will commit $(g ls-files -co --exclude-standard | wc -l | tr -d ' ') files (the whole project) and push, then its Fleet folder"; fi
else
  echo "  it will not commit: this project was launched before"
fi
read -r -p "Go ahead? [y/N] " answer
[[ "$answer" == [yY]* ]] || die "stopped; nothing was changed outside this folder"

# ---------------------------------------------------------------- C. now it acts

if [[ -z "$origin" ]]; then
  step "Creating the repository on GitHub"
  gh_ repo create "$slug" --public >/dev/null
  g remote add origin "$GIT_BASE/$slug.git"
fi

step "Writing the project's files"
pieces=()
[[ "$apikind" == none ]] || pieces=(api)
written=$(bash "$here/k8s-new-project" repo "$repo" "$project" "${pieces[@]}" "${knobs[@]}")
echo "$written" | sed 's/^/  /'
wrote() { grep -qE "^(wrote|rewrote) $1\$" <<<"$written"; }

if [[ ${#vite[@]} -gt 0 ]]; then
  args= lines=
  for pair in "${vite[@]}"; do
    n=${pair%%=*}
    printf '%s' "${pair#*=}" | gh_ variable set "$n" -R "$slug" >/dev/null
    args+="ARG $n\n" lines+="            $n=\${{ vars.$n }}\n"
  done
  # only files this run wrote are touched: the template leaves a marked place for exactly this
  ! wrote frontend/Dockerfile || sed -i "s~^# ARG VITE_API_URL\$~${args%\\n}~" "$repo/frontend/Dockerfile"
  if wrote .github/workflows/image.yml; then
    sed -i -e '/^          #   VITE_API_URL=/d' -e "s~^          # build-args: |\$~          build-args: |\n${lines%\\n}~" "$repo/.github/workflows/image.yml"
  fi
  echo "  build values stored on GitHub: $(printf '%s ' "${vite[@]%%=*}")"
  [[ "$webkind" != own ]] || echo "  note: the web app has its own Dockerfile; it needs an ARG line for each of them"
fi

if [[ -z "$hashook" ]]; then
  step "The webhook that tells Flux about each build"
  # the secret goes from its file to GitHub, never onto a command line or the screen.
  # gh is a Windows program and gets no path translation (gh_), so it is handed the Windows form.
  tokenfile=$HOOK_TOKEN
  ! command -v cygpath >/dev/null || tokenfile=$(cygpath -w "$HOOK_TOKEN")
  gh_ api "repos/$slug/hooks" -f name=web -F active=true -f 'events[]=workflow_run' \
    -f "config[url]=$HOOK_HOST$hookpath" -f 'config[content_type]=json' -F "config[secret]=@$tokenfile" >/dev/null
  echo "  $HOOK_HOST/hook/... on every workflow run"
fi

# the images the pods start with
webtag= apitag=
if [[ -n "$first" ]]; then
  step "First commit and push of the project"
  if [[ -n "$hascommits" ]]; then
    mapfile -t add < <(sed -nE 's/^(wrote|rewrote) //p' <<<"$written")
    g -c core.safecrlf=false add -- .gitignore "${add[@]}"
    # a run after a failed first build has nothing new to commit: it goes on from the push
    g diff --cached --quiet || g commit -q -m "build workflow: the project is launched"
  else
    g -c core.safecrlf=false add -A
    g commit -q -m "first commit, with the build workflow"
  fi
  g push -q -u origin main
  sha=$(g rev-parse HEAD)
  echo "  pushed ${sha:0:7}"

  step "Waiting for the images"
  run=
  for _ in $(seq 1 30); do
    run=$(gh_ run list -R "$slug" --commit "$sha" --json databaseId -q '.[0].databaseId' 2>/dev/null || true)
    [[ -z "$run" ]] || break
    sleep 3
  done
  [[ -n "$run" ]] || die "no pipeline run appeared for this push. Look at https://github.com/$slug/actions"$'\n'"Run this again once it is green: it continues from there"
  gh_ run watch "$run" -R "$slug" --exit-status >/dev/null 2>&1 \
    || die "the pipeline run failed: https://github.com/$slug/actions/runs/$run"$'\n'"Fix the cause and push. Then run this again: it continues from there"
  echo "  the run is green"
  # the tag the workflow gave this build: the commit, and the commit's own time
  tag=main-$sha-$(g show -s --format=%ct "$sha")
  webtag=$tag
  [[ "$apikind" == none ]] || apitag=$tag
else
  webtag=$(sed -nE 's~.*-web:([^ ]+) # \{"\$imagepolicy".*~\1~p' "$a/web.yaml" | head -1)
  apitag=
  if [[ "$apikind" != none ]]; then
    apitag=$(sed -nE 's~.*-api:([^ ]+) # \{"\$imagepolicy".*~\1~p' "$a/api.yaml" 2>/dev/null | head -1 || true)
    # a backend added after the launch has no image yet: its pod waits for the first build
    [[ -n "$apitag" ]] || apitag=main
  fi
fi
[[ "$webtag" =~ $TAG_RE && ( -z "$apitag" || "$apitag" =~ $TAG_RE ) ]] || die "could not tell which images to run (from $a/web.yaml)"

step "The project's folder in Fleet"
fleetargs=("$name" "$webtag")
[[ -z "$apitag" ]] || fleetargs+=("$apitag")
[[ -z "$hasenv" ]] || fleetargs+=(env)
fwritten=$(bash "$here/k8s-new-project" fleet "$fleet" "$project" "${fleetargs[@]}" "${knobs[@]}")
echo "$fwritten" | sed 's/^/  /'
if [[ -n "$send" ]]; then
  # SOPS encrypts each value with the cluster's public key: only the cluster can read the result.
  # The plain copy (Windows line endings taken out) lives a moment in a folder only you can read.
  mkdir -p "$HOME/.fleet"
  tmpdir=$(mktemp -d "$HOME/.fleet/tmp.XXXXXX")
  trap 'rm -rf "$tmpdir"' EXIT
  chmod 700 "$tmpdir"
  tr -d '\r' < "$envfile" > "$tmpdir/backend.env"
  sops -e --input-type dotenv --output-type dotenv --age "$recipient" "$tmpdir/backend.env" > "$a/backend.env.new" \
    || { rm -f "$a/backend.env.new"; die "sops could not encrypt the settings"; }
  rm -rf "$tmpdir"
  mv "$a/backend.env.new" "$a/backend.env"
  echo "  encrypted the backend's settings into apps/$project/backend.env"
fi

if [[ -z "$first" ]]; then
  step "Done. The commits are yours"
  changes=$(g status --short)
  fchanges=$(f status --short)
  [[ -z "$changes" ]] || { echo "In the project:"; echo "$changes" | sed 's/^/  /'; }
  [[ -z "$fchanges" ]] || { echo "In Fleet:"; echo "$fchanges" | sed 's/^/  /'; }
  if [[ -z "$changes$fchanges" ]]; then
    echo "Nothing changed."
  else
    echo "Look at them (git diff), commit and push: the project first, then Fleet (git pull --rebase before)."
    [[ "$apitag" != main ]] || echo "A backend that was just added runs once its first build is done: until then /api answers nothing."
  fi
  exit 0
fi

step "First commit and push of the Fleet folder"
f -c core.safecrlf=false add -- "apps/$project" "clusters/rem-vm/app-$project.yaml"
f commit -q -m "launch $project ($slug)"
f push -q origin main || { f pull -q --rebase && f push -q origin main; } || die "could not push Fleet. Look at it (git status), push it yourself, and the project goes live"
echo "  pushed"

step "Waiting for the site"
code=
for _ in $(seq 1 40); do
  code=$(curl -s -o /dev/null -m 10 -w '%{http_code}' "https://$site/" || true)
  [[ "$code" != 200 ]] || break
  sleep 5
done
[[ "$code" == 200 ]] || die "Fleet is pushed but https://$site/ answers ${code:-nothing} after 3 minutes. On the VPS: sudo flux get kustomizations app-$project"
step "Live: https://$site"
echo "From now on a push to main deploys it. To take it out: delete apps/$project/ and clusters/rem-vm/app-$project.yaml from Fleet in one commit."
