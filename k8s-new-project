#!/bin/bash
# Fills in k8s-template/ for one project. k8s-launch runs it for you; by hand, on the PC (Git Bash):
#
#   ./k8s-new-project repo  <project folder> <project> [api] [setting=value ...]
#   ./k8s-new-project fleet <Fleet folder> <project> <repository> <web tag> [api tag] [env] [setting=value ...]
#
#   ./k8s-new-project repo  ../MyApp my-app api
#   ./k8s-new-project fleet ../Fleet my-app MyApp main-<commit>-<time> main-<commit>-<time> env
#
# repo:  the project's own files: the workflow, and a Dockerfile for each piece that has none.
#        "api" when the project has a backend.
# fleet: the project's folder in the Fleet repo (apps/<project>/) and its line for Flux
#        (clusters/rem-vm/app-<project>.yaml). The tags are the images the pods start with. "env" when
#        apps/<project>/backend.env holds the backend's settings (k8s-launch encrypts it).
#
# A file that already exists is kept as it is, so a project's own Dockerfile is never touched and
# running this twice changes nothing. One exception: when a backend is asked for and a file was
# written without one (the workflow, or the Fleet folder's list and image files), it is written again.
# In a project folder only if it is committed and unchanged since, so git diff shows what changed.
# It commits nothing.
#
# The settings are for a project with its own Dockerfile; each has the template's value by default:
#   web-port=8080  web-health=/healthz  web-user=      web-mem=64     (user empty: the image's own)
#   api-port=3000  api-health=/         api-user=1000  api-mem=256    (memory in MB)
set -euo pipefail

die() { echo "k8s-new-project: $1" >&2; exit 2; }

NAME_RE='^[a-z0-9]([a-z0-9-]{0,28}[a-z0-9])?$'
REPO_RE='^[A-Za-z0-9._-]+$'
TAG_RE='^(main|main-[0-9a-f]{40}-[0-9]+)$'
HEALTH_RE='^/[A-Za-z0-9._/-]*$'

usage="usage: k8s-new-project repo <project folder> <project> [api] [setting=value ...]
       k8s-new-project fleet <Fleet folder> <project> <repository> <web tag> [api tag] [env] [setting=value ...]"
[[ $# -ge 3 ]] || die "$usage"
mode=$1 dir=$2 project=$3
shift 3
repo= webtag= apitag= env= api=
case $mode in
  repo)
    if [[ $# -gt 0 && "$1" == api ]]; then api=1; shift; fi ;;
  fleet)
    [[ $# -ge 2 ]] || die "$usage"
    repo=$1 webtag=$2; shift 2
    if [[ $# -gt 0 && "$1" != *=* && "$1" != env ]]; then apitag=$1; api=1; shift; fi
    if [[ $# -gt 0 && "$1" == env ]]; then env=1; shift; fi ;;
  *) die "$usage" ;;
esac

declare -A k=([web-port]=8080 [web-health]=/healthz [web-user]= [web-mem]=64
              [api-port]=3000 [api-health]=/ [api-user]=1000 [api-mem]=256)
for pair in "$@"; do
  [[ "$pair" == *=* && -v "k[${pair%%=*}]" ]] || die "unknown setting: $pair"
  k[${pair%%=*}]=${pair#*=}
done

[[ -d "$dir" ]] || die "$dir is not a folder"
[[ -d "$dir/.git" ]] || die "$dir is not a git repository"
[[ "$project" =~ $NAME_RE ]] || die "the project name may only have lowercase letters, digits and dashes (30 at most)"
[[ -z "$repo" || "$repo" =~ $REPO_RE ]] || die "a repository name may only have letters, digits, dots, dashes and underscores"
[[ -z "$webtag" || "$webtag" =~ $TAG_RE ]] || die "not an image tag of main: $webtag"
[[ -z "$apitag" || "$apitag" =~ $TAG_RE ]] || die "not an image tag of main: $apitag"
[[ -z "$env" || -n "$api" ]] || die "settings (env) are for a backend, and there is none"
for piece in web api; do
  port=${k[$piece-port]} health=${k[$piece-health]} user=${k[$piece-user]} mem=${k[$piece-mem]}
  # a program that is not root cannot listen below 1024
  { [[ "$port" =~ ^[0-9]{4,5}$ ]] && (( port >= 1024 && port <= 65535 )); } || die "$piece-port must be between 1024 and 65535"
  [[ "$health" =~ $HEALTH_RE ]] || die "$piece-health must be a path like /healthz"
  [[ -z "$user" || "$user" =~ ^[1-9][0-9]{0,5}$ ]] || die "$piece-user must be a user number that is not 0 (root)"
  { [[ "$mem" =~ ^[0-9]{2,4}$ ]] && (( mem >= 32 && mem <= 2048 )); } || die "$piece-mem must be between 32 and 2048 (MB)"
done
# what the template promises the backend up front; the ceiling cannot be below it
(( k[api-mem] >= 96 )) || die "api-mem must be at least 96 (MB)"

template="$(cd "$(dirname "$0")" && pwd)/k8s-template"
if [[ $mode == repo ]]; then
  # the repository's name on GitHub, for the label that links an image to its repository
  repo=$(basename "$(git -C "$dir" remote get-url origin 2>/dev/null || echo "$project")" .git)
  [[ "$repo" =~ $REPO_RE ]] || die "the repository's name on GitHub has characters this cannot handle: $repo"
fi

# the template marks its backend-only and settings-only lines; what is not wanted is dropped
cut=()
if [[ -n "$api" ]]; then cut+=(-e '/# api:(begin|end)$/d'); else cut+=(-e '/# api:begin$/,/# api:end$/d'); fi
if [[ -n "$env" ]]; then cut+=(-e '/^# env:(begin|end)$/d'); else cut+=(-e '/^# env:begin$/,/^# env:end$/d'); fi
# no user number given: the line goes, and the image's own user is used
[[ -n "${k[web-user]}" ]] || cut+=(-e '/WEB_USER/d')
[[ -n "${k[api-user]}" ]] || cut+=(-e '/API_USER/d')

fill() { # $1 file in the template, $2 where it goes
  mkdir -p "$(dirname "$dir/$2")"
  sed -E "${cut[@]}" \
    -e "s|WEB_TAG|$webtag|g; s|API_TAG|$apitag|g" \
    -e "s|WEB_PORT|${k[web-port]}|g; s|WEB_HEALTH|${k[web-health]}|g; s|WEB_USER|${k[web-user]}|g; s|WEB_MEM|${k[web-mem]}|g" \
    -e "s|API_PORT|${k[api-port]}|g; s|API_HEALTH|${k[api-health]}|g; s|API_USER|${k[api-user]}|g; s|API_MEM|${k[api-mem]}|g" \
    -e "s|PROJECT|$project|g; s|REPO|$repo|g" \
    "$template/$1" > "$dir/$2"
}

# true if a file that exists lacks a part now asked for: the backend, or the settings
lacks() { # $1 where it is
  case $1 in
    .github/workflows/image.yml) [[ -n "$api" ]] && ! grep -q -- "$project-api:" "$dir/$1" ;;
    apps/*/images.yaml) [[ -n "$api" ]] && ! grep -q -- "-api$" "$dir/$1" ;;
    apps/*/kustomization.yaml) { [[ -n "$api" ]] && ! grep -q -- "- api.yaml" "$dir/$1"; } || { [[ -n "$env" ]] && ! grep -q "secretGenerator" "$dir/$1"; } ;;
    *) return 1 ;;
  esac
}

# pairs: where the template's file is, where it goes
pairs=()
if [[ $mode == repo ]]; then
  pairs+=(.github/workflows/image.yml .github/workflows/image.yml)
  # a piece that brings its own Dockerfile gets none of the template's files for that piece
  [[ -e "$dir/frontend/Dockerfile" ]] || pairs+=(frontend/Dockerfile frontend/Dockerfile frontend/nginx.conf frontend/nginx.conf frontend/.dockerignore frontend/.dockerignore)
  [[ -z "$api" || -e "$dir/backend/Dockerfile" ]] || pairs+=(backend/Dockerfile backend/Dockerfile backend/.dockerignore backend/.dockerignore)
else
  a=apps/$project
  pairs+=(fleet/namespace.yaml "$a/namespace.yaml" fleet/web.yaml "$a/web.yaml" fleet/images.yaml "$a/images.yaml"
          fleet/kustomization.yaml "$a/kustomization.yaml" fleet/flux.yaml "clusters/rem-vm/app-$project.yaml")
  [[ -z "$api" ]] || pairs+=(fleet/api.yaml "$a/api.yaml")
fi

for ((i = 0; i < ${#pairs[@]}; i += 2)); do
  from=${pairs[i]} to=${pairs[i + 1]}
  if [[ ! -e "$dir/$to" ]]; then
    fill "$from" "$to"; echo "wrote $to"
  elif lacks "$to"; then
    # in Fleet, k8s-launch checked the folder is clean before; in a project, only committed files
    if [[ $mode == fleet ]] || { git -C "$dir" ls-files --error-unmatch "$to" >/dev/null 2>&1 && git -C "$dir" diff --quiet HEAD -- "$to"; }; then
      fill "$from" "$to"; echo "rewrote $to"
    else
      die "$to has no backend part and has changes that are not committed. Commit or undo them, then run this again"
    fi
  else
    echo "kept $to"
  fi
done
