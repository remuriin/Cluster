#!/bin/bash
# Puts the cluster files of k8s-template/ into a project's repository, with the names filled in.
# k8s-launch runs it for you; by hand, on the PC (Git Bash):
#
#   ./k8s-new-project <repo folder> <project> <site> <web address> [api address] [setting=value ...]
#   ./k8s-new-project ../MyApp my-app my-app.remservers.me 10.43.0.84 10.43.0.85
#
# <project> becomes the namespace and the start of the image names. Leave the api address out (or
# write "-") for a project that is only a web app.
#
# A file that already exists is kept as it is, so a project's own Dockerfile is never touched and
# running this twice changes nothing. One exception: when a backend is asked for and the workflow
# or the nginx site was written without one, that file is written again from the template, but only
# if it is committed and unchanged since (git diff then shows exactly what changed). It commits nothing.
#
# The settings are for a project with its own Dockerfile; each has the template's value by default:
#   web-port=8080  web-health=/healthz  web-user=      web-mem=64     (user empty: the image's own)
#   api-port=3000  api-health=/         api-user=1000  api-mem=256    (memory in MB)
#
# k8s-up-project uses "--render <folder>" on the VPS: only the cluster files and the nginx site,
# into any folder, with no repository needed.
set -euo pipefail

die() { echo "k8s-new-project: $1" >&2; exit 2; }

NAME_RE='^[a-z0-9]([a-z0-9-]{0,28}[a-z0-9])?$'
SITE_RE='^([a-z0-9-]+\.)+[a-z]{2,}$'
# the hand-picked service addresses: 10.43.0.80 to 10.43.0.249
IP_RE='^10\.43\.0\.(8[0-9]|9[0-9]|1[0-9][0-9]|2[0-4][0-9])$'
HEALTH_RE='^/[A-Za-z0-9._/-]*$'

render=
if [[ "${1:-}" == --render ]]; then render=1; shift; fi
[[ $# -ge 4 ]] || die "usage: k8s-new-project <repo folder> <project> <site> <web address> [api address] [setting=value ...]"
repo=$1 project=$2 site=$3 web=$4
shift 4
api=
if [[ $# -gt 0 && "$1" != *=* ]]; then api=$1; shift; fi
[[ "$api" != - ]] || api=

declare -A k=([web-port]=8080 [web-health]=/healthz [web-user]= [web-mem]=64
              [api-port]=3000 [api-health]=/ [api-user]=1000 [api-mem]=256)
for pair in "$@"; do
  [[ "$pair" == *=* && -v "k[${pair%%=*}]" ]] || die "unknown setting: $pair"
  k[${pair%%=*}]=${pair#*=}
done

[[ -d "$repo" ]] || die "$repo is not a folder"
[[ -n "$render" || -d "$repo/.git" ]] || die "$repo is not a git repository"
[[ "$project" =~ $NAME_RE ]] || die "the project name may only have lowercase letters, digits and dashes (30 at most)"
[[ "$site" =~ $SITE_RE ]] || die "expected a site name like my-app.remservers.me"
[[ "$web" =~ $IP_RE ]] || die "the web address must be between 10.43.0.80 and 10.43.0.249"
[[ -z "$api" || "$api" =~ $IP_RE ]] || die "the api address must be between 10.43.0.80 and 10.43.0.249"
[[ "$web" != "$api" ]] || die "the two addresses must differ"
for piece in web api; do
  port=${k[$piece-port]} health=${k[$piece-health]} user=${k[$piece-user]} mem=${k[$piece-mem]}
  # a program that is not root cannot listen below 1024
  { [[ "$port" =~ ^[0-9]{4,5}$ ]] && (( port >= 1024 && port <= 65535 )); } || die "$piece-port must be between 1024 and 65535"
  [[ "$health" =~ $HEALTH_RE ]] || die "$piece-health must be a path like /healthz"
  [[ -z "$user" || "$user" =~ ^[1-9][0-9]{0,5}$ ]] || die "$piece-user must be a user number that is not 0 (root)"
  { [[ "$mem" =~ ^[0-9]{2,4}$ ]] && (( mem >= 32 && mem <= 2048 )); } || die "$piece-mem must be between 32 and 2048 (MB)"
done
# what the template promises the backend up front; the ceiling cannot be below it
(( k[api-mem] >= 96 )) || die "api-mem must be at least 96 (MB)"

template="$(cd "$(dirname "$0")" && pwd)/k8s-template"
# the repository's name on GitHub, for the label that links an image to its repository
github=$project
[[ -n "$render" ]] || github=$(basename "$(git -C "$repo" remote get-url origin 2>/dev/null || echo "$project")" .git)
[[ "$github" =~ ^[A-Za-z0-9._-]+$ ]] || die "the repository's name on GitHub has characters this cannot handle: $github"

files=(k8s/namespace.yaml k8s/web.yaml nginx-site.conf)
[[ -z "$api" ]] || files+=(k8s/api.yaml)
if [[ -z "$render" ]]; then
  files+=(.github/workflows/image.yml)
  # a piece that brings its own Dockerfile gets none of the template's files for that piece
  [[ -e "$repo/frontend/Dockerfile" ]] || files+=(frontend/Dockerfile frontend/nginx.conf frontend/.dockerignore)
  [[ -z "$api" || -e "$repo/backend/Dockerfile" ]] || files+=(backend/Dockerfile backend/.dockerignore)
fi

# the template marks its backend-only lines; a web-only project drops them, any other drops the marks
if [[ -n "$api" ]]; then strip='/# api:(begin|end)$/d'; else strip='/# api:begin$/,/# api:end$/d'; fi
# no user number given: the line goes, and the image's own user is used
drop=()
[[ -n "${k[web-user]}" ]] || drop+=(-e '/WEB_USER/d')
[[ -n "${k[api-user]}" ]] || drop+=(-e '/API_USER/d')

fill() {
  mkdir -p "$(dirname "$repo/$1")"
  sed -E -e "$strip" "${drop[@]}" \
    -e "s|SITE_NAME|$site|g; s|WEB_IP|$web|g; s|API_IP|$api|g" \
    -e "s|WEB_PORT|${k[web-port]}|g; s|WEB_HEALTH|${k[web-health]}|g; s|WEB_USER|${k[web-user]}|g; s|WEB_MEM|${k[web-mem]}|g" \
    -e "s|API_PORT|${k[api-port]}|g; s|API_HEALTH|${k[api-health]}|g; s|API_USER|${k[api-user]}|g; s|API_MEM|${k[api-mem]}|g" \
    -e "s|PROJECT|$project|g; s|REPO|$github|g" \
    "$template/$1" > "$repo/$1"
}

# true if a file that exists was written for a web-only project and a backend is now asked for
lacks_backend() {
  [[ -n "$api" ]] || return 1
  case $1 in
    .github/workflows/image.yml) ! grep -q -- "$project-api:" "$repo/$1" ;;
    nginx-site.conf) ! grep -q 'location /api' "$repo/$1" ;;
    *) return 1 ;;
  esac
}

for f in "${files[@]}"; do
  if [[ ! -e "$repo/$f" ]]; then
    fill "$f"; echo "wrote $f"
  elif lacks_backend "$f"; then
    if [[ -n "$render" ]] || { git -C "$repo" ls-files --error-unmatch "$f" >/dev/null 2>&1 && git -C "$repo" diff --quiet HEAD -- "$f"; }; then
      fill "$f"; echo "rewrote $f"
    else
      die "$f has no backend part and has changes that are not committed. Commit or undo them, then run this again"
    fi
  else
    echo "kept $f"
  fi
done

[[ -n "$render" ]] || echo "namespace $project, site $site, web $web${api:+, api $api}, repository remuriin/$github"
