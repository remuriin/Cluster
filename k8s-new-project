#!/bin/bash
# Puts the cluster files of k8s-template/ into a project's repository, with the names filled in.
# Run on the PC (Git Bash), never on the VPS:
#
#   ./k8s-new-project <repo folder> <project> <site> <web address> [api address]
#   ./k8s-new-project ../MyApp my-app my-app.remservers.me 10.43.0.83 10.43.0.84
#
# <project> becomes the namespace and the start of the image names. Leave the api address out for a
# project that is only a web app. It never overwrites a file, and it commits nothing.
set -euo pipefail

die() { echo "k8s-new-project: $1" >&2; exit 2; }

NAME_RE='^[a-z0-9]([a-z0-9-]{0,28}[a-z0-9])?$'
SITE_RE='^([a-z0-9-]+\.)+[a-z]{2,}$'
# the hand-picked service addresses: 10.43.0.80 to 10.43.0.249
IP_RE='^10\.43\.0\.(8[0-9]|9[0-9]|1[0-9][0-9]|2[0-4][0-9])$'

[[ $# -eq 4 || $# -eq 5 ]] || die "usage: k8s-new-project <repo folder> <project> <site> <web address> [api address]"
repo=$1 project=$2 site=$3 web=$4 api=${5:-}
[[ -d "$repo/.git" ]] || die "$repo is not a git repository"
[[ "$project" =~ $NAME_RE ]] || die "the project name may only have lowercase letters, digits and dashes (30 at most)"
[[ "$site" =~ $SITE_RE ]] || die "expected a site name like my-app.remservers.me"
[[ "$web" =~ $IP_RE ]] || die "the web address must be between 10.43.0.80 and 10.43.0.249"
[[ -z "$api" || "$api" =~ $IP_RE ]] || die "the api address must be between 10.43.0.80 and 10.43.0.249"
[[ "$web" != "$api" ]] || die "the two addresses must differ"

template="$(cd "$(dirname "$0")" && pwd)/k8s-template"
# the repository's name on GitHub, for the label that links an image to its repository
github=$(basename "$(git -C "$repo" remote get-url origin 2>/dev/null || (cd "$repo" && pwd))" .git)

files=(frontend/Dockerfile frontend/nginx.conf frontend/.dockerignore k8s/namespace.yaml k8s/web.yaml
       nginx-site.conf .github/workflows/image.yml)
[[ -z "$api" ]] || files+=(backend/Dockerfile backend/.dockerignore k8s/api.yaml)

for f in "${files[@]}"; do
  [[ ! -e "$repo/$f" ]] || die "$repo/$f already exists, nothing was written"
done

# the template marks its backend-only lines; a web-only project drops them, any other drops the marks
if [[ -n "$api" ]]; then strip='/# api:(begin|end)$/d'; else strip='/# api:begin$/,/# api:end$/d'; fi

for f in "${files[@]}"; do
  mkdir -p "$(dirname "$repo/$f")"
  sed -E -e "$strip" -e "s/SITE_NAME/$site/g; s/WEB_IP/$web/g; s/API_IP/$api/g; s/PROJECT/$project/g; s/REPO/$github/g" \
    "$template/$f" > "$repo/$f"
  echo "wrote $f"
done

echo
echo "Next: the checklist in k8s-template/README.md, from step 2. Your values:"
echo "  namespace $project, site $site, web $web${api:+, api $api}, repository remuriin/$github"
